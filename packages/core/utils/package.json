{
  "name": "@mawm/core/utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.3.0",
    "@opencode-ai/plugin": "1.14.28"
  },
  "exports": {
    "./langgraph/nodes/interactive.ts": "./src/langgraph/nodes/interactive.ts",
    "./langgraph/nodes/*.ts": "./src/langgraph/nodes/*.ts",
    "./opencode/plugins/*.ts": "./dist/opencode/plugins/*.ts",
    "./opencode/tools/*.ts": "./dist/opencode/tools/*.ts",
    "./graph/*.ts": "./dist/graph/*.ts",
    "./prompts/*.md": "./dist/prompts/*.md"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "eslint src",
    "lint:all": "bun lint && bun format:check"
  }
}
