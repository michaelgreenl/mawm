{
  "name": "@mawm/utils",
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.3.0",
    "@opencode-ai/plugin": "1.14.28"
  },
  "exports": {
    "./nodes/*": "./src/nodes/*",
    "./tools/*": "./src/tools/*",
    "./prompts/*": "./src/prompts/*"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "eslint src",
    "lint:all": "bun lint && bun format:check"
  }
}
