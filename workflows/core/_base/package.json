{
  "name": "@mawm/workflows/base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@mawm/core/utils": "workspace:*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "eslint src",
    "lint:all": "bun lint && bun format:check"
  }
}
