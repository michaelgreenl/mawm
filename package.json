{
  "name": "@mawm/cli",
  "version": "0.2.0",
  "description": "A TypeScript CLI for packaging, installing, and running LangGraph workflow templates with manifest-based distribution and bundled OpenCode execution assets.",
  "license": "MIT-with-Commons-Clause",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/michaelgreenl/mawm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelgreenl/mawm.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mawm": "./bin/mawm.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "clean": "rm -rf dist",
    "rebuild": "bun clean && bun run build",
    "rebuild:link": "bun rebuild && bun link",
    "prepublishOnly": "bun rebuild",
    "release": "CI=true semantic-release",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "lint": "eslint src test",
    "lint:all": "bun lint && bun format:check",
    "hooks": "husky"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.2",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bun": "latest",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
