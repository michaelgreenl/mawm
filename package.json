{
  "name": "mawm",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/cli",
    "packages/core",
    "packages/core/*",
    "workflows/core/*"
  ],
  "scripts": {
    "format": "bun --workspaces --sequential --no-exit-on-error format",
    "lint": "bun --workspaces --sequential --no-exit-on-error lint:all",
    "typecheck": "bun --workspaces --sequential --no-exit-on-error typecheck",
    "hooks": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/bun": "latest",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "typescript": "^5",
    "typescript-eslint": "^8.32.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3"
  }
}
