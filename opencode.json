{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "packages/core/utils/src/prompts/guidance/general.md",
    "packages/core/utils/src/prompts/guidance/runtime/bun-pm-node-runtime.md"
  ],
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "allow",
          "coder": "deny"
        }
      }
    },
    "truth-seeker": {
      "*": "allow",
      "write": "deny"
    },
    "planner": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "prompt": "{file:.opencode/agents/planner.md}"
    },
    "manager": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "prompt": "{file:.opencode/agents/manager.md}"
    },
    "coder": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "prompt": "{file:.opencode/agents/coder.md} {file:packages/core/utils/src/prompts/coding/clean-code-ts.md}"
    },
    "code-reviewer": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "prompt": "{file:.opencode/agents/code-reviewer.md} {file:packages/core/utils/src/prompts/coding/clean-code-ts.md}"
    }
  }
}
