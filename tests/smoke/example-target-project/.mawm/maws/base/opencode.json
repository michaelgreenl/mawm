{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["./prompts/general.md", "./prompts/bun-pm-node-runtime.md"],
  "plugins": ["./plugins/secret-guard.ts", "./plugins/graph-transition.ts"],
  "model": "openai/gpt-5.4",
  "variant": "xhigh",
  "agent": {
    "coder": {
      "prompt": "{file:./agents/coder.md} {file:./prompts/clean-code-ts.md}"
    },
    "code-reviewer": {
      "prompt": "{file:./agents/code-reviewer.md} {file:./prompts/clean-code-ts.md}"
    }
  }
}
