{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["./prompts/general.md", "./prompts/bun-pm-node-runtime.md"],
  "plugins": ["./plugins/secret-guard.js", "./plugins/graph-transition.js"],
  "agent": {
    "planner": {
      "description": "Planning-only agent that writes roadmap, initiative, phase, and step plan docs after clearing assumptions",
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "prompt": "{file:./agents/planner.md}",
      "permission": {
        "edit": "allow",
        "inject-variant": "allow",
        "openviking-find": "allow",
        "question": "allow",
        "websearch": "allow",
        "task": {
          "explore": "allow",
          "general": "allow"
        },
        "skill": {
          "test-driven-development": "deny"
        }
      }
    },
    "manager": {
      "description": "Executes a phase plan.md step by step by calling planner for step plans, coordinating coder and code-reviewer subagents, validating results, and committing clean steps",
      "mode": "primary",
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "prompt": "{file:./agents/manager.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "inject-variant": "allow",
        "openviking-find": "allow",
        "task": {
          "*": "deny",
          "planner": "allow",
          "coder": "allow",
          "code-reviewer": "allow",
          "explore": "allow",
          "general": "allow"
        },
        "skill": {
          "test-driven-development": "deny"
        }
      }
    },
    "coder": {
      "description": "TDD-focused implementor dispatched by the manager for a specific step plan and review iteration",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "prompt": "{file:./agents/coder.md} {file:./prompts/clean-code-ts.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "openviking-find": "allow",
        "skill": { "test-driven-development": "allow" }
      }
    },
    "code-reviewer": {
      "description": "Read-only code-review subagent that audits a step implementation for quality, security, performance, scalability, regressions, structure, and standards",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "prompt": "{file:./agents/code-reviewer.md} {file:./prompts/clean-code-ts.md}",
      "permission": {
        "bash": "allow",
        "openviking-find": "allow",
        "skill": { "test-driven-development": "deny" }
      }
    }
  }
}
